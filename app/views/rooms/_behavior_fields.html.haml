.row-card.behavior.nested-fields
  .row-top
    .grow
      %span.mini-label Trigger
      = f.select :trigger, Behavior::POSSIBLE_TRIGGERS, {}, class: "mini-input"
    .grow
      %span.mini-label Chance (0-1)
      = f.number_field :chance, step: 0.1, min: 0, max: 1, class: "mini-input data"
    .row-actions
      %button.btn.small.danger-ghost{type: "button", data: { action: "nested-fields#remove" }} Remove

  .npc-sub{data: { controller: "nested-fields" }}
    .field-label Actions
    .rows{data: { nested_fields_target: "target" }}
      = f.fields_for :actions do |ac|
        = render "action_fields", f: ac
    %template{data: { nested_fields_target: "template" }}
      = f.fields_for :actions, BehaviorAction.new, child_index: "NEW_RECORD" do |ac|
        = render "action_fields", f: ac
    %button.add-row-btn{type: "button", data: { action: "nested-fields#add" }} + Add action

  = f.hidden_field :id if f.object.persisted?
  = f.hidden_field :_destroy
