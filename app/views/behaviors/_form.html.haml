= form_with(model: behavior) do |form|
  - if behavior.errors.any?
    %div{style: "color: red"}
      %h2= "#{pluralize(behavior.errors.count, "error")} prohibited this behavior from being saved:"

      %ul
        - behavior.errors.each do |error|
          %li= error.full_message

  %div
    = form.label :npc_id, style: "display: block"
    = form.text_field :npc_id

  %div
    = form.label :trigger, style: "display: block"
    = form.text_field :trigger

  %div
    = form.label :chance, style: "display: block"
    = form.text_field :chance

  %div
    = form.submit
